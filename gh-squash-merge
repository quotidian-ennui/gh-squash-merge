#!/usr/bin/env bash
set -eo pipefail
readonly GH_REST_API_VERSION="X-GitHub-Api-Version: 2022-11-28"
readonly GH_ACCEPT="Accept: application/vnd.github+json"

WORK_FILE=$(mktemp --tmpdir squash-merge-commit-msg.XXXXXX)
ASYNC_WORK_FILE=""
# Reuse from merge-train because this is the likely caller
POLL_INTERVAL_SECS=${GH_POLL_INTERVAL_SECS:-30}
# Reuse from merge-train because this is the likely caller
GH_MERGE_TRAIN_MAX_ATTEMPTS=${GH_MERGE_TRAIN_MAX_ATTEMPTS:-4}

cleanup() {
  if [[ -n "${WORK_FILE:-}" ]]; then
    rm -f "$WORK_FILE"
  fi
  if [[ -n "${ASYNC_WORK_FILE:-}" ]]; then
    rm -f "$ASYNC_WORK_FILE"
  fi
}

usage() {
  cat <<EOF

Usage: gh squash-merge [<number> | <url> | <branch>] [flags]

Issues a squash merge on the PR.

Without an argument, the pull request that belongs to the current branch
is used.

Arguments
  <number> The PR number to squash merge
  <url> The PR URL to squash merge
  <branch> The branch of PR URL to squash merge

Flags
      --admin                    Use administrator privileges to merge a pull request that does not meet requirement
      --auto                     Automatically merge only after necessary requirements are met
      --async                    Use the merge-async API command; cannot be used with --admin or --auto
  -R, --repo [HOST/]OWNER/REPO   Select another repository using the [HOST/]OWNER/REPO format
      --dry-run                  dry run; in effect print the message that would be used for the squash commit
  -U, --use-default-msg          If there is nothing that could be used as the message; just do
                                 gh pr merge --delete-branch --squash
Notes:
- The title of the commit will be based on GitHub repository settings
- The PR body contains a section similar to the following which lets us autogenerate
  squash merge commit message
- If PR body does not contain a section similar an empty body will be set

<!-- SQUASH_MERGE_START -->
- this forms the body of the commit message and could be multiple lines
but generally we tend towards
- doc: conventional commit messages
<!-- SQUASH_MERGE_END -->

EXAMPLES
gh squash-merge
gh squash-merge 811
gh squash-merge --repo quotidian-ennui/gh-squash-merge 811
gh squash-merge https://github.com/quotidian-ennui/gh-squash-merge/pull/811
gh squash-merge feature/update

EOF
  exit 1
}

trap cleanup 1 2 15

additional_args=()

__sleep() {
  local msg="$1"
  echo -e "$msg"
  sleep "$POLL_INTERVAL_SECS"
}

async_url() {
  local pr_url="$1"
  if [[ "$pr_url" =~ ^https://[^/]+/([^/]+)/([^/]+)/pull/([0-9]+)$ ]]; then
    printf 'repos/%s/%s/pulls/%s/merge-async\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  else
    printf 'Invalid pull request URL: %s\n' "$pr_url" >&2
    return 1
  fi
}

merge_response() {
  local response="$1"
  jq -r '.status // empty' <<<"$response"
}

execute_async_merge() {
  local pr_url="$1"
  local async_payload_file="$2"
  local async_url
  local mergeAttempts=0
  local max_retries=$GH_MERGE_TRAIN_MAX_ATTEMPTS

  async_url="$(async_url "$pr_url")"
  response=$(gh_api --method PUT --input "$async_payload_file" "$async_url")
  uuid=$(jq -r '.details.uuid // empty' <<<"$response")
  if [[ -z "$uuid" ]]; then
    echo "⚠️ Async merge response missing UUID" >&2
    return 1
  fi
  while [[ $(merge_response "$response") != "merged" ]]; do
    mergeAttempts=$((mergeAttempts + 1))
    if [[ "$mergeAttempts" -ge "$max_retries" ]]; then
      echo -e "\n🚫 Failed to merge in good time"
      return 1
    else
      __sleep "💤 Waiting on async-merge to catch up, $POLL_INTERVAL_SECS seconds..."
      response=$(gh_api "${async_url%/}/$uuid")
    fi
  done
  echo "ℹ️ Async merge status: $(merge_response "$response")"
  return 0
}

build_title() {
  local title="$2"
  local number="$1"
  printf '%s (#%s)' "$title" "$number"
}

create_async_payload() {
  local commit_title="$1"
  local work_file="$2"

  ASYNC_WORK_FILE=$(mktemp --tmpdir squash-merge-async.XXXXXX)
  if has_data; then
    jq --null-input \
      --arg commit_title "$commit_title" \
      --rawfile commit_message "$work_file" \
      '{commit_title: $commit_title, commit_message: $commit_message, merge_method: "squash", merge_action: "default"}' \
      >"$ASYNC_WORK_FILE"
  else
    jq --null-input \
      --arg commit_title "$commit_title" \
      '{commit_title: $commit_title, merge_method: "squash", merge_action: "default"}' \
      >"$ASYNC_WORK_FILE"
  fi
}

gh_api() {
  gh api -H "$GH_REST_API_VERSION" -H "$GH_ACCEPT" "$@"
}

has_data() {
  if [[ -s "$WORK_FILE" ]] && grep -qE '[^[:space:]]' "$WORK_FILE"; then
    return 0
  fi
  return 1
}

DRY_RUN=false
USE_DEFAULT_MSG=false
ASYNC=false
ARGS=$(getopt --options 'R::hU' --longoptions 'repo:,help,admin,auto,async,dry-run,use-default-msg' -- "${@}")
eval "set -- ${ARGS}"
while true; do
  case "${1}" in
  --dry-run)
    DRY_RUN=true
    shift
    ;;
  --use-default-msg | -U)
    USE_DEFAULT_MSG=true
    shift
    ;;
  --async)
    ASYNC=true
    shift
    ;;
  --help | -h)
    usage
    ;;
  --repo | -R)
    repo="${2}"
    shift 2
    ;;
  --admin | --auto)
    additional_args+=("${1}")
    shift
    ;;
  --)
    shift
    break
    ;;
  *)
    usage
    ;;
  esac
done

if [[ "$ASYNC" == "true" && ${#additional_args[@]} -gt 0 ]]; then
  echo "--async cannot be used with --admin or --auto"
  exit 1
fi

remaining_args=("${1}")

if [ -n "${repo:-}" ] && [ -z "${remaining_args:-}" ]; then
  echo "argument required when using the --repo flag"
  usage
fi

details_args=()

if [ -n "${repo:-}" ]; then
  details_args+=('--repo')
  details_args+=("${repo}")
fi

if [ -n "${remaining_args:-}" ]; then
  details_args+=("${remaining_args}")
fi

pr_view=$(gh pr view --json "number,body,url,title" $"${details_args[@]}")

body=$(jq -r '.body' <<<"$pr_view")
number=$(jq -r '.number' <<<"$pr_view")
pr_url=$(jq -r '.url' <<<"$pr_view")
pr_title="$(build_title "$number" "$(jq -r '.title' <<<"$pr_view")")"

commit_msg=$(echo "$body" | awk '/SQUASH_MERGE_START/,/SQUASH_MERGE_END/' | { grep -v "SQUASH_MERGE" || test $? = 1; } | tr -d '\r' | sed '/^$/N;/^\n$/D')
printf '%s\n' "$commit_msg" >"$WORK_FILE"

if [[ "$ASYNC" == "true" ]]; then
  create_async_payload "$pr_title" "$WORK_FILE"
fi

if [[ "$DRY_RUN" == "true" ]]; then
  echo -e "$pr_title\n"
  if has_data; then
    cat "$WORK_FILE"
  else
    echo "⚠️ no squash-merge body in the PR"
  fi
else
  if has_data; then
    if [[ "$ASYNC" == "true" ]]; then
      execute_async_merge "$pr_url" "$ASYNC_WORK_FILE"
    else
      gh pr merge "$pr_url" --delete-branch --squash --body-file "$WORK_FILE" $"${additional_args[@]}"
    fi
  else
    if [[ "$USE_DEFAULT_MSG" == "true" ]]; then
      echo -e "\nℹ️ Using Default Message"
      if [[ "$ASYNC" == "true" ]]; then
        execute_async_merge "$pr_url" "$ASYNC_WORK_FILE"
      else
        gh pr merge "$pr_url" --delete-branch --squash $"${additional_args[@]}"
      fi
    else
      echo -e "\n⚠️ no squash-merge body in the PR, not merging"
    fi
  fi
fi

cleanup
